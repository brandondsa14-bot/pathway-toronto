# Local development (do not store credentials in Git)
PATHWAY_ENV=development
# Do not set this in dev unless using a different explicitly trusted frontend.
# PATHWAY_ALLOWED_ORIGINS=http://localhost:3000

# Production MUST use HTTPS allowlisted frontend origin(s) and a deployment host.
# PATHWAY_ENV=production
# PATHWAY_ALLOWED_ORIGINS=https://pathway.example.com
